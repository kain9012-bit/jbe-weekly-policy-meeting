# Python
__pycache__/
*.pyc

# Node / 빌드 산출물
node_modules/
dist/
_site/

# 비밀값
.env
.env.local
*.cookies.txt

# 수집 중 생긴 임시 자막 파일 (data/ 안의 결과물은 커밋한다)
/tmp/
*.srt

# 받아쓰기용 원본 오디오.
# 회차당 25MB 안팎이라 금방 수백 MB가 된다. 어차피 유튜브에서 언제든 다시 받을 수
# 있고(오디오받기.bat), 저장소에 둘 이유가 없다. 받아쓴 결과(data/asr/)만 커밋한다.
data/audio/
*.webm
*.m4a
*.mp3
*.wav

# 되돌리기용으로 옮겨 둔 파일
_to_delete/

# 단, 테스트 픽스처는 반드시 커밋한다
!collector/tests/fixture_captions.json3
!collector/tests/fixture_captions.vtt

# Skill 은 폴더가 원본이다. 묶은 결과물(.skill)은 build.py 로 언제든 다시 만든다.
skill/*.skill
