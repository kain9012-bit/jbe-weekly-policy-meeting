    {
      "t": 331,
      "text": "같은 경우 정비할 수 있도록 저희가"
    },
    {
      "t": 332,
      "text": "안내를 할 예정으로 있고요. 11월"
    },
    {
      "t": 335,
      "text": "12월에는 그 플랫폼 구축을 해서"
    },
    {
      "t": 337,
      "text": "위원회가 어 체계적이고 내실 있게 운영될",
      "raw": "위원회가 어 체계적이고 내시게 운영될"
    },
    {
      "t": 340,
      "text": "수 있도록 할 계획으로 있습니다."
    },
    {
      "t": 341,
      "text": ">> 현재 위원회가 몇 개 정도 있어요?"
    },
    {
      "t": 342,
      "text": "우리"
    },
    {
      "t": 343,
      "text": ">> 511개 있습니다."
    },
    {
      "t": 344,
      "text": ">> 몇 개요? 511개요."
    },
    {
      "t": 347,
      "text": ">> 우와. 500 몇 개라면 그 뭐"
    },
    {
      "t": 350,
      "text": "그러니까요."
    },
    {
      "t": 351,
      "text": ">> 본청에 111개가 있고요. 교육"
    },
    {
      "t": 353,
      "text": "지원청에 400개 정도가 있습니다."
    },
    {
      "t": 355,
      "text": ">> 아, 지원까지 다 합쳐서"
    },
    {
      "t": 357,
      "text": ">> 그러니까 이제 각 지원에도 말씀을"
    },
    {
      "t": 360,
      "text": "하셔서"
    },
    {
      "t": 361,
      "text": ">> 이런 위원회들이"
    },
    {
      "t": 364,
      "text": ">> 그 통합할 수 있는 거 하고"
    },
    {
      "t": 366,
      "text": "실질적으로 내실화 될 수 있도록",
      "raw": "실질적으로 내시화 될 수 있도록"
    },
    {
      "t": 368,
      "text": "지원청에도 좀"
    },
    {
      "t": 370,
      "text": ">> 어. 부탁드립니다."
    },
    {
      "t": 371,
      "text": ">> 네. 알겠습니다."
    },
    {
      "t": 372,
      "text": ">> 예."
    },
    {
      "t": 373,
      "text": "중등교육과 선생님에 대한 인사상"
    },
    {
      "t": 376,
      "text": "우대방 수업 고민 좀 해 보셨어요?"
    },
    {
      "t": 379,
      "text": ">> 예. 그 초등 교육과 함께 그 1,"
    },
    {
      "t": 382,
      "text": "2차 협의회를 통해서 지금 현재 중등"
    },
    {
      "t": 385,
      "text": "수업 성장인증제하고 유초동 특수의",
      "raw": "수업 성장 인증제어하고 유초동 특수의"
    },
    {
      "t": 387,
      "text": "수업혁신 선도교사단 어 현황을 먼저",
      "raw": "수업신 선도교사단 어 현황을 먼저"
    },
    {
      "t": 390,
      "text": "파악했고요. 그다음에 지금 이제 추진"
    },
    {
      "t": 392,
      "text": "방향을 정했는데 9월 중에 9월 중에"
    },
    {
      "t": 396,
      "text": "유초등 대표 선생님들 그리고 이제"
    },
    {
      "t": 398,
      "text": "유관 부서 담당자들과 함께 TF",
      "raw": "유관부사 담당자들과 함께 TF"
    },
    {
      "t": 400,
      "text": "구성해서 어 인사 관련 협의를 좀"
    },
    {
      "t": 403,
      "text": "일차적으로 하고요. 그다음에 어 학교"
    },
    {
      "t": 405,
      "text": "현장 설문을 통해서 안을 도출해서"
    },
    {
      "t": 409,
      "text": "가급적 10월 중에 어 수업자라는"
    },
    {
      "t": 412,
      "text": "교사가 우대하는 정책을 만들어 갈"
    },
    {
      "t": 415,
      "text": "계획을 갖고 있습니다."
    },
    {
      "t": 416,
      "text": ">> 네. 어, 사실 현장에서는 굉장히"
    },
    {
      "t": 419,
      "text": "열심히 준비하고 고민하고 하는"
    },
    {
      "t": 422,
      "text": "선생님들 되게 많으시거든요. 이게"
    },
    {
      "t": 424,
      "text": "자율적으로 뭔가 이런 일들이 진행될"
    },
    {
      "t": 427,
      "text": "때 훨씬 효과가 크니까 너무나"
    },
    {
      "t": 430,
      "text": "강제하거나 그러지 마시고 자율적으로"
    },
    {
      "t": 433,
      "text": "수업 공개도 이루어질 수 있도록 하고"
    },
    {
      "t": 436,
      "text": "여기에 적극적으로 참여하시는 분들 어"
    },
    {
      "t": 439,
      "text": "선발해서 좋은 기회를 드릴 수 있는"
    },
    {
      "t": 442,
      "text": "이런 방향으로 방향을 좀 잡았으면"
    },
    {
      "t": 443,
      "text": "좋겠습니다. 자, 그러면 이제 주관"
    },
    {
      "t": 446,
      "text": "업무 발표로 이어가겠습니다."
    },
    {
      "t": 449,
      "text": "꼭 안내나 공유할 내용이 있는 부서"
    },
    {
      "t": 452,
      "text": "중심으로 말씀해 주시고요. 정책국,"
    },
    {
      "t": 455,
      "text": "교육국, 행정국 순서로 그렇게 이어갈"
    },
    {
      "t": 458,
      "text": "수 있도록 하겠습니다. 네."
    },
    {
      "t": 462,
      "text": ">> 네. 대변인실에서 하나 홍보",
      "raw": ">> 네. 대변실에서 하나 홍보"
    },
    {
      "t": 464,
      "text": "말씀드리겠습니다. 26. 2026년"
    },
    {
      "t": 466,
      "text": "교육가족 공모전을 추진하는데요. 어",
      "raw": "교육가족 공무전을 추진하는데요. 어"
    },
    {
      "t": 469,
      "text": "새롭게 시도되고 있는 우리 전북 교육"
    },
    {
      "t": 471,
      "text": "정책에 대해서 교육 공동체 관심과"
    },
    {
      "t": 474,
      "text": "관심을 고취하고 공감대를 확산하기"
    },
    {
      "t": 476,
      "text": "위해서 어 공모전을 실시하는데요. 어",
      "raw": "위해서 어 공무전을 실시하는데요. 어"
    },
    {
      "t": 479,
      "text": "주제는 도전과 모험 살아가는"
    },
    {
      "t": 481,
      "text": "힘입니다. 어 동시 포토시 쇼트폼"
    },
    {
      "t": 484,
      "text": "영상 어 만화 등네 개 분야를"
    },
    {
      "t": 486,
      "text": "공모하는데요. 학생과 동일연령의"
    },
    {
      "t": 489,
      "text": "청소년, 교직원, 그리고 자녀와 한"
    },
    {
      "t": 492,
      "text": "학부모가 함께 참여할 수 있으면서"
    },
    {
      "t": 493,
      "text": "있으며 여기 계신 모든 분들도 어"
    },
    {
      "t": 496,
      "text": "교육청 소속 직원들도 모두 참여하실"
    },
    {
      "t": 498,
      "text": "수 있습니다. 관심 갖고 어 홍보에"
    },
    {
      "t": 501,
      "text": "같이 동참해 주시면 감사하겠고요."
    },
    {
      "t": 503,
      "text": "8월 18일 오늘부터 공고할"
    },
    {
      "t": 504,
      "text": "예정이고요. 10월 1일부터 작품을"
    },
    {
      "t": 507,
      "text": "접수할 예정입니다. 예. 이상"
    },
    {
      "t": 508,
      "text": "말씀드렸습니다."
    },
    {
      "t": 511,
      "text": ">> 네. 도전 모험 살아가는 힘 주제로"
    },
    {
      "t": 514,
      "text": "그렇게 지금 공모전하는 거죠요. 하는"
    },
    {
      "t": 517,
      "text": "거잖아요. 예. 저희가 모두에도 항상"
    },
    {
      "t": 520,
      "text": "제가 강조해 왔듯이 이게 도전"
    },
    {
      "t": 523,
      "text": "프로그램을"
    },
    {
      "t": 524,
      "text": "각 학교에서도 다 준비하게 될테니까요"
    },
    {
      "t": 527,
      "text": "부분에 대해서 아마 선도적으로 우리"
    },
    {
      "t": 529,
      "text": "대변인실에서 이렇게 준비하는 거"
    },
    {
      "t": 531,
      "text": "같으니까 계속 그런 분위기를 좀"
    },
    {
      "t": 534,
      "text": "유도하면서"
    },
    {
      "t": 535,
      "text": "학교 자체가 어떤 프로젝트 형태랄지"
    },
    {
      "t": 538,
      "text": "이런 걸로 도전해 갈 수 있는 것을"
    },
    {
      "t": 540,
      "text": "미리미리 좀 준비해 볼 수 있는 그런"
    },
    {
      "t": 543,
      "text": "분위기를 조성하는게 중요할 거라고"
    },
    {
      "t": 544,
      "text": "보거든요. 예. 그렇게 해 주시고"
    },
    {
      "t": 547,
      "text": "다음 듣겠습니다."
    },
    {
      "t": 549,
      "text": "검사관실입니다."
    },
    {
      "t": 551,
      "text": "오늘부터 28일까지 학교 근무 모든"
    },
    {
      "t": 553,
      "text": "직원들을 대상으로 2026년 반부패"
    },
    {
      "t": 556,
      "text": "청 시스템 모의 훈련을 실시합니다."
    },
    {
      "t": 559,
      "text": "목적은 늘봄 반가 학교에 발생 가능한"
    },
    {
      "t": 562,
      "text": "청탁과 업체 선정 등의 딜레마 상황에"
    },
    {
      "t": 565,
      "text": "대한 실전 대응 능력을 키우고 청식을"
    },
    {
      "t": 568,
      "text": "내재화하는 것입니다."
    },
    {
      "t": 571,
      "text": "이번 [목을 가다듬음] 훈련을 통해"
    },
    {
      "t": 571,
      "text": "현장의 부패 취약 분야에 대한"
    },
    {
      "t": 573,
      "text": "경각심을 높이고 실질적인 대응 역량을"
    },
    {
      "t": 576,
      "text": "강화할 수 있도록 하겠습니다. 그리고"
    },
    {
      "t": 579,
      "text": "잠시 후 11시에는 2026년 청년"
    },
    {
      "t": 582,
      "text": "콘텐츠"
    },
    {
      "t": 584,
      "text": "공모전 시상식이 있습니다. 이번",
      "raw": "공무전 시상식이 있습니다. 이번"
    },
    {
      "t": 586,
      "text": "공모전은 학생, 학부모, 교직원이",
      "raw": "공무전은 학생, 학부모, 교직원이"
    },
    {
      "t": 589,
      "text": "함께 청년의 가치를 고민하고"
    },
    {
      "t": 591,
      "text": "창의적으로 표현하는 계기가"
    },
    {
      "t": 592,
      "text": "되었습니다. 수상작들은 앞으로 청년"
    },
    {
      "t": 595,
      "text": "문화 확산을 위한 홍보 자료로 적극"
    },
    {
      "t": 597,
      "text": "활용하도록 하겠습니다. 이상입니다."
    },
    {
      "t": 600,
      "text": ">> 네. 다음 부서로 가시죠."
    },
    {
      "t": 603,
      "text": "[목을 가다듬음] 네. 정책기획과",
      "raw": "[목을 가다듬음] 네. 정책 계획과"
    },
    {
      "t": 605,
      "text": "말씀드리겠습니다."
    },
    {
      "t": 612,
      "text": "다 어 정책과 말씀드리겠습니다."
    },
    {
      "t": 614,
      "text": "제20대 교육감 공약 사업 실천 계획"
    },
    {
      "t": 616,
      "text": "수립입니다. 어 전북 특별자치도"
    },
    {
      "t": 619,
      "text": "교육감 공약상 관리 규칙 제5조"
    },
    {
      "t": 622,
      "text": "제4항 총괄부서는 공약 사업 실천"
    },
    {
      "t": 625,
      "text": "계획을 교육감 취임일 이후 4개월"
    },
    {
      "t": 628,
      "text": "이내에 최종 확정해야 한다. 이에"
    },
    {
      "t": 630,
      "text": "근거하여"
    },
    {
      "t": 632,
      "text": "교육감 공약 사항과 인수위원회 제한"
    },
    {
      "t": 635,
      "text": "공약 사업관 연계성 확보와 공약"
    },
    {
      "t": 638,
      "text": "사업의 정책 목표 실현을 위한 확인"
    },
    {
      "t": 640,
      "text": "지표, 추진 계획 등 구체성이 현재"
    },
    {
      "t": 643,
      "text": "파악한 결과 미흡한 상황입니다. 이에"
    },
    {
      "t": 646,
      "text": "따라서 어 공약 사업 재정비로 공약상"
    },
    {
      "t": 649,
      "text": "누약을 방지하여 도민과의 약속 이행을"
    },
    {
      "t": 652,
      "text": "강화하고 공약 사업 실행력 강화가"
    },
    {
      "t": 655,
      "text": "목적입니다."
    },
    {
      "t": 656,
      "text": "해당 부서에서는 공약 사항의 적절성과"
    },
    {
      "t": 659,
      "text": "실현 가능성 그리고 투자 재원의 조달"
    },
    {
      "t": 663,
      "text": "가능성 여부 등 고려하여 실천 계획을"
    },
    {
      "t": 665,
      "text": "수립하여 주십시오."
    },
    {
      "t": 667,
      "text": "협조 사항으로는 담당자인의 업무가"
    },
    {
      "t": 670,
      "text": "아닌 부서 업무로 판 파악하시고"
    },
    {
      "t": 674,
      "text": "협업해 주시고"
    },
    {
      "t": 676,
      "text": "필요시 부서별 실무 TF를 구성하여"
    },
    {
      "t": 679,
      "text": "팀장님 주관하의 교차 검토를 통한"
    },
    {
      "t": 681,
      "text": "실천 계획을 수립하고 부서관 협의를"
    },
    {
      "t": 684,
      "text": "통해 세세부 과제를 취합 제출할"
    },
    {
      "t": 687,
      "text": "부서까지 지정하여 추진해 주시기를"
    },
    {
      "t": 690,
      "text": "부탁드리겠습니다. 이상으로 발표를"
    },
    {
      "t": 692,
      "text": "마치겠습니다."
    },
    {
      "t": 694,
      "text": ">> 네. 공약 추진을 확인하는"
    },
    {
      "t": 698,
      "text": "기구가 있죠. 네. 네."
    },
    {
      "t": 700,
      "text": ">> 아니, 어느 정도 실행되는지를"
    },
    {
      "t": 702,
      "text": "확인하는 기구는 없나요?"
    },
    {
      "t": 704,
      "text": ">> 체크를 해야 됩니다. 저희가."
    },
    {
      "t": 705,
      "text": ">> 예. 우리 어디에서 체크를 합니까?"
    },
    {
      "t": 707,
      "text": ">> 홈페이지에 있고요. 저희 부서에"
    },
    {
      "t": 709,
      "text": "담당자가 따로 있습니다."
    },
    {
      "t": 710,
      "text": ">> 아, 네. 정책 기획과에서"
    },
    {
      "t": 713,
      "text": ">> 네, 그렇습니다."
    },
    {
      "t": 713,
      "text": ">> 체크를 하는군요."
    },
    {
      "t": 714,
      "text": ">> 네네."
    },
    {
      "t": 715,
      "text": "뭐 공약이 정말로 빈 공약이 안"
    },
    {
      "t": 718,
      "text": "되도록 여기 계시는 이제 우리"
    },
    {
      "t": 721,
      "text": "관부님들이 그걸 잘 챙기셔야 되니까"
    },
    {
      "t": 724,
      "text": "잘 진행될 수 있는가를 확인"
    },
    {
      "t": 726,
      "text": "부탁드립니다. 네. 다음 부서"
    },
    {
      "t": 728,
      "text": "가겠습니다."
    },
    {
      "t": 737,
      "text": ">> 네. 문회체학과 14페이지"
    },
    {
      "t": 739,
      "text": "말씀드리겠습니다."
    },
    {
      "t": 741,
      "text": ">> 2026년 체육인재 진로진학 한마당을"
    },
    {
      "t": 744,
      "text": "운영합니다. 학생 선수 등록 선수가"
    },
    {
      "t": 748,
      "text": "아닌 일반 학생 중에 체육 진료"
    },
    {
      "t": 751,
      "text": "체육개월 진로를 희망하는 학생을"
    },
    {
      "t": 752,
      "text": "대상으로 8월 22일에 전북 체육"
    },
    {
      "t": 755,
      "text": "중고등학교에서 어 돈의 고등학생"
    },
    {
      "t": 757,
      "text": "170여명을"
    },
    {
      "t": 759,
      "text": "대상으로 실시합니다. 어 구성 내용은"
    },
    {
      "t": 763,
      "text": "명사 특강 선수 출신 하태곤 전"
    },
    {
      "t": 765,
      "text": "배드민턴 선수와 그리고 이도현 현재"
    },
    {
      "t": 769,
      "text": "전북 현대 모터스 축구 단장 비선수"
    },
    {
      "t": 772,
      "text": "출신인데요.이 두 분의 특강에 이어"
    },
    {
      "t": 774,
      "text": "실기 측정과 그리고 대학별 부스"
    },
    {
      "t": 778,
      "text": "그리고 내신 성적 등을 통한 개인"
    },
    {
      "t": 780,
      "text": "맞춤면 맞춤명 상담 등을 진행할"
    },
    {
      "t": 783,
      "text": "계획입니다. 이후 향후 일반 선수"
    },
    {
      "t": 786,
      "text": "학생 학생 선수를 대상으로 한 차례"
    },
    {
      "t": 788,
      "text": "어 비슷한 유형의 행사를 가질"
    },
    {
      "t": 790,
      "text": "기획입니다. 이상 보고"
    },
    {
      "t": 792,
      "text": "마치겠습니다.네"
    },
    {
      "t": 796,
      "text": ">> 다음 가겠습니다.네"
    },
    {
      "t": 797,
      "text": ">> 민주 시민 교육과 말씀드리겠습니다."
    },
    {
      "t": 800,
      "text": "지난 8월 12일 수요일 날 전주의"
    },
    {
      "t": 803,
      "text": "모고등학교 어 여학생이 약물 과다"
    },
    {
      "t": 807,
      "text": "복용으로 어 이제 자살를 시도한"
    },
    {
      "t": 809,
      "text": "사건이 있었는데요. 다행히 생명에는"
    },
    {
      "t": 813,
      "text": "어 위험이 없는 걸로 알고 있습니다."
    },
    {
      "t": 816,
      "text": "요즘 우리 학생들의 그 우울감 증가와"
    },
    {
      "t": 819,
      "text": "또 학업 스트레스로 인한 가정내의"
    },
    {
      "t": 822,
      "text": "이런 불화등으로 인해서 자살를"
    },
    {
      "t": 824,
      "text": "시도하는 학생들이 증가하고 있습니다."
    },
    {
      "t": 828,
      "text": "이에 따라 저희 독일청에서는"
    },
    {
      "t": 831,
      "text": "학생 생명지킴 전담 TF팀을 구성을"
    },
    {
      "t": 834,
      "text": "해서 운영하고자 합니다. 목적은 학생"
    },
    {
      "t": 838,
      "text": "자살 발생인 분석 및 예방 대책 마련"
    },
    {
      "t": 842,
      "text": "그리고 전문 인력풀을 활용한 현장"
    },
    {
      "t": 845,
      "text": "밀착현 긴급 지원책의 구축 및 협력"
    },
    {
      "t": 848,
      "text": "강화가 목적입니다. 구성은 어"
    },
    {
      "t": 851,
      "text": "도교육청에 저를 중심으로 한 유기"
    },
    {
      "t": 854,
      "text": "지원단 그리고 교육지원청의"
    },
    {
      "t": 857,
      "text": "정신건강 전문의를 포의를 포함한 긴급"
    },
    {
      "t": 861,
      "text": "지원팀 그리고 유관기관인 청소년"
    },
    {
      "t": 865,
      "text": "상담복지 센터 정신건강 복지 센터"
    },
    {
      "t": 868,
      "text": "등으로 구성을 하였습니다."
    },
    {
      "t": 871,
      "text": "어 학생 생명지킴 전담 TF의 역할은"
    },
    {
      "t": 874,
      "text": "어 학생들의 자살 예방 및 대응"
    },
    {
      "t": 877,
      "text": "안전망을 구축하고 학생들의 자살 원인"
    },
    {
      "t": 880,
      "text": "분석과 유기 대응 긴급 지원 체계를"
    },
    {
      "t": 884,
      "text": "마련하고자 함입니다. 1차 협의회를"
    },
    {
      "t": 887,
      "text": "8월 20일 목요일 날 10시부터"
    },
    {
      "t": 891,
      "text": "우리과 회의실에서 가지시려고"
    },
    {
      "t": 892,
      "text": "하는데요. 학생 자살 원인에 대한"
    },
    {
      "t": 895,
      "text": "기관별 분석 자료를 서로 공유하고"
    },
    {
      "t": 898,
      "text": "서로 정책을 제한하고자 합니다. 어이"
    },
    {
      "t": 902,
      "text": "회의 이후에는 어 자살 발생시"
    },
    {
      "t": 905,
      "text": "위기지원단 긴급 회의를 개최할",
      "raw": "유기지원단 긴급 회의를 개최할"
    },
    {
      "t": 907,
      "text": "거고요. 기관별로 생명지킴이행 실적",
      "raw": "거고요. 기관별로 생명지킴 이행 실적"
    },
    {
      "t": 911,
      "text": "공유 및 협력 체계를 구축하고자"
    },
    {
      "t": 914,
      "text": "합니다. 이쪽의 주요 행사는 자료로"
    },
    {
      "t": 917,
      "text": "자료를 참고해 주시기 바랍니다. 이상"
    },
    {
      "t": 919,
      "text": "말씀드렸습니다."
    },
    {
      "t": 921,
      "text": ">> 네."
    },
    {
      "t": 923,
      "text": "그 제가 정말로 많이 강조하고 싶은"
    },
    {
      "t": 926,
      "text": "내용 중에 하나입니다.이 부분이 우리"
    },
    {
      "t": 929,
      "text": "전북의 아이들이 공부도 잘하고"
    },
    {
      "t": 933,
      "text": "뭐 본인의 소지를 잘 찾아서 무럭무럭"
    },
    {
      "t": 936,
      "text": "잘 크고 이런 것을 우리가 바라고"
    },
    {
      "t": 939,
      "text": "있는데 그 이면에 정말 심리"
    },
    {
      "t": 942,
      "text": "정서적으로 어려워하는 애들이 굉장히"
    },
    {
      "t": 945,
      "text": "많아요. 여러 가지 통계를 보면서"
    },
    {
      "t": 948,
      "text": "저도 깜짝 놀라고 있는데이 부분만큼은"
    },
    {
      "t": 952,
      "text": "우리의 정말로 그 깊은 관심과 노력이"
    },
    {
      "t": 955,
      "text": "없으면 안 된다고 생각하거든요."
    },
    {
      "t": 958,
      "text": "아이들의 생명을 지키고 안전하게"
    },
    {
      "t": 960,
      "text": "보호하는게 정말 1번 임무 중에"
    },
    {
      "t": 963,
      "text": "중요한 임무라고 하는 걸 다시"
    },
    {
      "t": 966,
      "text": "되새기면서"
    },
    {
      "t": 967,
      "text": "그 뭡니까? 학교에 지금 공문도"
    },
    {
      "t": 970,
      "text": "보냈죠?"
    },
    {
      "t": 972,
      "text": "예."
    },
    {
      "t": 973,
      "text": ">> 네."
    },
    {
      "t": 973,
      "text": ">> 예. 공문도 좀 보내서 이거는"
    },
    {
      "t": 975,
      "text": "가까이에 있는 분들이 관심을 갖고"
    },
    {
      "t": 979,
      "text": "아주 즉각적으로 대응을 하지 않으면"
    },
    {
      "t": 981,
      "text": "안 되는 부분이니까 일선 학교에"
    },
    {
      "t": 985,
      "text": "계시는 분들 교장 선생님들이 특히"
    },
    {
      "t": 987,
      "text": "학교 내에서 관심을 더 가질 수"
    },
    {
      "t": 989,
      "text": "있도록 그렇게 경각심을",
      "raw": "있도록 그렇게 경강심을"
    },
    {
      "t": 992,
      "text": "더 좀 갖게 해 주셨으면 하는 부탁"
    },
    {
      "t": 994,
      "text": "말씀드립니다."
    },
    {
      "t": 996,
      "text": "네. 다음 부서 가시죠. 네. 그"
    },
    {
      "t": 999,
      "text": "미래교육 정책 연구소"
    },
    {
      "t": 1001,
      "text": "말씀드리겠습니다."
    },
    {
      "t": 1003,
      "text": "어 올해 고등학교 2학년 학생들부터"
    },
    {
      "t": 1005,
      "text": "적용되는 2028학년도 대학 입학"
    },
    {
      "t": 1008,
      "text": "전형은 내신 5등급제 성취 평가와"
    },
    {
      "t": 1012,
      "text": "석차 등급 통합형 대학 수학 능력"
    },
    {
      "t": 1015,
      "text": "시험 체제 등 많은 변화가 있습니다."
    },
    {
      "t": 1018,
      "text": "어 8월 이슈 페이퍼에서 어 시행",
      "raw": "어 8월 이슈 페이프에서 어 시행"
    },
    {
      "t": 1021,
      "text": "계획의 주요 특징 수도권 및 지방"
    },
    {
      "t": 1024,
      "text": "거점대학의 전형 변화 그리고 이런"
    },
    {
      "t": 1026,
      "text": "변화에 따른 고등학교 진로진학 교육"
    },
    {
      "t": 1029,
      "text": "대응 방안을 다루었습니다. 어 아울러"
    },
    {
      "t": 1032,
      "text": "한 가지 더 말씀드릴 것은 지난 회의"
    },
    {
      "t": 1035,
      "text": "때 교육감 지시사항에 대한 처리",
      "raw": "때 교육감지지 사항에 대한 처리"
    },
    {
      "t": 1037,
      "text": "결과입니다."
    },
    {
      "t": 1039,
      "text": "어 교육청 소속 박사학위 소지 교원의",
      "raw": "어 교육청 소속 박사학기 소지 교원의"
    },
    {
      "t": 1042,
      "text": "전공 그리고 연구 분야 등을 파악하여"
    },
    {
      "t": 1045,
      "text": "어 데이터베이스를 구축하고 정책"
    },
    {
      "t": 1048,
      "text": "연구와 자문 등에 적극 활용하라는"
    },
    {
      "t": 1050,
      "text": "당부의 말씀이 있었는데요. 어"
    },
    {
      "t": 1053,
      "text": "인사가와 협의에서 현재 어 처리"
    },
    {
      "t": 1056,
      "text": "중이고요. 어 뭐 인사 이동이나"
    },
    {
      "t": 1058,
      "text": "이런게 좀 있어서 좀 늦어지긴 하는데"
    },
    {
      "t": 1060,
      "text": "9월 중순까지는 어 데이터베이스를"
    },
    {
      "t": 1063,
      "text": "구축하고 9월 말까지는 협력 방안을"
    },
    {
      "t": 1067,
      "text": "어 마련할 계획입니다. 이상입니다."
    },
    {
      "t": 1070,
      "text": ">> 네. 진로 진학 교육이에 관한 대응"
    },
    {
      "t": 1073,
      "text": "방안이기 때문에 이게 중등 교육과나"
    },
    {
      "t": 1075,
      "text": "이런 데하고 특별히 연계를 좀 잘해야"
    },
    {
      "t": 1077,
      "text": "될 것 같아요. 네. 항상 협력하면서"
    },
    {
      "t": 1080,
      "text": "연구 진행하고 있습니다."
    },
    {
      "t": 1081,
      "text": ">> 네. 다음 부수록 가겠습니다."
    },
    {
      "t": 1084,
      "text": ">> 네. 총무과 말씀드리겠습니다."
    },
    {
      "t": 1087,
      "text": "2026년을지 연습입니다. 주요"
    },
    {
      "t": 1089,
      "text": "내용입니다. 오늘 6시 비상 소집"
    },
    {
      "t": 1092,
      "text": "훈련을 시작으로 최초 상황 보고까지"
    },
    {
      "t": 1094,
      "text": "있었습니다. 내일 8월 19일"
    },
    {
      "t": 1096,
      "text": "2시에는 완산 소방서와 합동으로 비밀"
    },
    {
      "t": 1100,
      "text": "반출 및 합동 소방 훈련이"
    },
    {
      "t": 1102,
      "text": "실시됩니다. 안내 방송에 따라서 제일"
    },
    {
      "t": 1105,
      "text": "주차장으로 이동하여 실시됩니다. 8월"
    },
    {
      "t": 1108,
      "text": "20일 목요일 2시에는을지 연습과"
    },
    {
      "t": 1110,
      "text": "연계한 공습 대비 민방위 대피 훈련이"
    },
    {
      "t": 1113,
      "text": "실시됩니다. 공습 경보가 물리면 안내"
    },
    {
      "t": 1116,
      "text": "요원의 대피 요도에 따라 지하"
    },
    {
      "t": 1118,
      "text": "주차장으로 이동하여 대피를 해 주시기"
    },
    {
      "t": 1121,
      "text": "바랍니다. 8월 21일 금요일"
    },
    {
      "t": 1123,
      "text": "9시에는 연습 상황 보고가"
    },
    {
      "t": 1125,
      "text": "있겠습니다. 각 기관 및 부서에서는"
    },
    {
      "t": 1127,
      "text": "의지 연습 기간의 행정 공교행 및"
    },
    {
      "t": 1130,
      "text": "기강회의 등 부적한 사례가 발생하지"
    },
    {
      "t": 1133,
      "text": "않도록 공직기 확립의 철저를 기하여"
    },
    {
      "t": 1136,
      "text": "주시기 바랍니다. 이상"
    },
    {
      "t": 1137,
      "text": "말씀드렸습니다."
    },
    {
      "t": 1140,
      "text": ">> 네. 삼박 4일 동안 함께 애써"
    },
    {
      "t": 1143,
      "text": "주시겠습니다. 제 다음 부석합니다."
    },
    {
      "t": 1147,
      "text": ">> 예. 행정과 말씀드리겠습니다. 저희"
    },
    {
      "t": 1149,
      "text": "행정과는 이번 주에 2027학년도"
    },
    {
      "t": 1152,
      "text": "고등학교 신입생 학급당 정원 배정"
    },
    {
      "t": 1155,
      "text": "계획을 수립합니다. 지역별 중학교"
    },
    {
      "t": 1158,
      "text": "졸업 예정자수, 전년도 학생 배치율"
    },
    {
      "t": 1161,
      "text": "등을 분석해서 평준화 일반고,"
    },
    {
      "t": 1163,
      "text": "비평준화 일반고 특성화고 특목고"
    },
    {
      "t": 1166,
      "text": "학급당 정원을 적정하게 조정하도록"
    },
    {
      "t": 1169,
      "text": "하겠습니다. 이상입니다."
    },
    {
      "t": 1171,
      "text": ">> 거기 학교 군 중학교 조정한 혹시"
    },
    {
      "t": 1174,
      "text": "조정된 뭐 사례가 있나요?"
    },
    {
      "t": 1178,
      "text": "예."
    },
    {
      "t": 1182,
      "text": "3월자로"
    },
    {
      "t": 1184,
      "text": ">> 2026년 3월 1일자로 폐지된 일곱"
    },
    {
      "t": 1187,
      "text": "개의 학교의 학교군 조정하는 거"
    },
    {
      "t": 1189,
      "text": "하고요. 하나는 선택권 확대를 위한"
    },
    {
      "t": 1192,
      "text": "중학교 조정인데요. 여기는 남원"
    },
    {
      "t": 1195,
      "text": "지역에 덕과면하고 정읍시의 덕천에 그"
    },
    {
      "t": 1199,
      "text": "민원이 있어서 그 내용을 어 수렴해서"
    },
    {
      "t": 1203,
      "text": "그 학부모들이 원하는 방향으로"
    },
    {
      "t": 1205,
      "text": "조정하는 내용입니다."
    },
    {
      "t": 1206,
      "text": ">> 아 그렇군요."
    },
    {
      "t": 1208,
      "text": "네."
    },
    {
      "t": 1210,
      "text": "다음 보도록 하겠습니다."
    },
    {
      "t": 1213,
      "text": ">> 네. 제목과 말씀드리겠습니다."
    },
    {
      "t": 1215,
      "text": "1번입니다. 공적 항공 마일지를"
    },
    {
      "t": 1217,
      "text": "활용해서 기부 물품 구입을 추진하고자"
    },
    {
      "t": 1220,
      "text": "합니다. 국계 출장으로 발생한 항공"
    },
    {
      "t": 1223,
      "text": "마일지리지를 활용한 기부 활동으로"
    },
    {
      "t": 1226,
      "text": "예산의 공공성 제고 및 사회 공원에"
    },
    {
      "t": 1228,
      "text": "기여하고자 합니다. 본 사업은 이번에"
    },
    {
      "t": 1232,
      "text": "처음 시행하는 사업입니다."
    },
    {
      "t": 1234,
      "text": "출장으로 발생한 항공 마일리지는 어"
    },
    {
      "t": 1237,
      "text": "출장시에 항공권 확보나 기부를"
    },
    {
      "t": 1240,
      "text": "목적으로 한 물품을 구매하는 등"
    },
    {
      "t": 1243,
      "text": "공쪽으로만 사용되어야 합니다. 그런데"
    },
    {
      "t": 1246,
      "text": "마일리지가 작고요"
    },
    {
      "t": 1248,
      "text": "기간이 10년으로 그 소멸되는 경우가"
    },
    {
      "t": 1251,
      "text": "많습니다. 이에 지난 5월에 소속"
    },
    {
      "t": 1255,
      "text": "공무원 전체를 대상으로 마일리지"
    },
    {
      "t": 1257,
      "text": "현황과 기부 희망자를 조사했습니다."
    },
    {
      "t": 1260,
      "text": "어이 보유한 것을 토대로 해서 이번에"
    },
    {
      "t": 1263,
      "text": "기부 활동을 추진하고자 합니다. 금의"
    },
    {
      "t": 1266,
      "text": "차에는 보유한 마일리 중 2년 이내의"
    },
    {
      "t": 1271,
      "text": "소멸 예정이거나 퇴직 예정자 마일리지",
      "raw": "수멸 예정이거나 퇴직 예정자 마일리지"
    },
    {
      "t": 1274,
      "text": "40명에 48만 마일리지로 금액으로"
    },
    {
      "t": 1278,
      "text": "환산하면 어 1 마일리지당 10원으로",
      "raw": "환산하면 어 1 마일리즈당 10원으로"
    },
    {
      "t": 1281,
      "text": "480만 원입니다.이를 이를 어"
    },
    {
      "t": 1284,
      "text": "물품으로 구입해서 대상자에게 물품"
    },
    {
      "t": 1286,
      "text": "구입을 안내하고 이번 9월 추석"
    },
    {
      "t": 1289,
      "text": "명절에 우리 교육청에서 사회복지 시설"
    },
    {
      "t": 1293,
      "text": "유문 방문 기무함으로써"
    },
    {
      "t": 1296,
      "text": "공익적 가치를 실현하고자 합니다."
    },
    {
      "t": 1299,
      "text": "어이 자리를 빌려서 마일리지 기부에"
    },
    {
      "t": 1301,
      "text": "동참해 주신 소속 공무원들께 감사의"
    },
    {
      "t": 1305,
      "text": "말씀드립니다. 이상입니다. 음,"
    },
    {
      "t": 1308,
      "text": "489만 원 정도가 마일리지로"
    },
    {
      "t": 1311,
      "text": "기부되는군요."
    },
    {
      "t": 1313,
      "text": ">> 네, 그렇습니다."
    },
    {
      "t": 1313,
      "text": ">> 감사합니다."
    },
    {
      "t": 1316,
      "text": ">> 네, 대충 제가 발표 부서는이 정도로"
    },
    {
      "t": 1319,
      "text": "들었는데요. 제가 자료 보면서 노사"
    },
    {
      "t": 1322,
      "text": "협력과의 그 소송 업무 수행하는 별"
    },
    {
      "t": 1326,
      "text": "민사 소송 변론길 참석이 한 건"
    },
    {
      "t": 1329,
      "text": "있던데 어떤 내용이에요?"
    },
    {
      "t": 1332,
      "text": ">> 임실에 제 폐던 공초에"
    },
    {
      "t": 1334,
      "text": ">> 예. 그 저기 건물에 거주하고 있는"
    },
    {
      "t": 1337,
      "text": "분이 있었는데요."
    },
    {
      "t": 1338,
      "text": ">> 아,"
    },
    {
      "t": 1339,
      "text": ">> 그 소송 관계 해 가지고 그분이 이제"
    },
    {
      "t": 1340,
      "text": "퇴하셨고가"
    },
    {
      "t": 1342,
      "text": ">> 나가셨습니까?"
    },
    {
      "t": 1343,
      "text": ">> 예, 나갔습니다."
    },
    {
      "t": 1344,
      "text": ">> 그래서 앞으로 소송 취하할",
      "raw": ">> 그래서 앞으로 소송 취약할"
    },
    {
      "t": 1346,
      "text": "예정입니다."
    },
    {
      "t": 1347,
      "text": ">> 예, 잘 정리가 되고 있다는 거죠."
    },
    {
      "t": 1350,
      "text": ">> 예."
    },
    {
      "t": 1350,
      "text": ">> 그리고 그 전북 교육 인권 센터"
    },
    {
      "t": 1354,
      "text": "쪽에서 지금 변호사 우리 변호사권은"
    },
    {
      "t": 1356,
      "text": "어떻게 지금 정리가 되고 있죠?"
    },
    {
      "t": 1359,
      "text": ">> 네. 인권센터 말씀드리겠습니다. 어",
      "raw": ">> 네. 인권세터 말씀드리겠습니다. 어"
    },
    {
      "t": 1362,
      "text": "저희가 교육 국무직으로 어 교권 전담",
      "raw": "저희가 교육 국무직으로 어 교건 전담"
    },
    {
      "t": 1365,
      "text": "변호사 한 명 그다음에 학폭 전단",
      "raw": "변호사 한 명 그다음에 합폭 전단"
    },
    {
      "t": 1367,
      "text": "변호사 한 명 이렇게 해서 추진을"
    },
    {
      "t": 1369,
      "text": "하고 있는데요. 지금 현재는 그 임금"
    },
    {
      "t": 1372,
      "text": "관련해서 설계 부분에 대해서 노사"
    },
    {
      "t": 1374,
      "text": "협력가와 논의 중입니다. 그래서 이번"
    },
    {
      "t": 1376,
      "text": "주 내로 논의가 끝나게 되면 계획을"
    },
    {
      "t": 1379,
      "text": "수립해서 운영하도록 하겠습니다."
    },
    {
      "t": 1381,
      "text": ">> 네. 변호사 빨리 선임될 수 있도록"
    },
    {
      "t": 1383,
      "text": "절차를 최대한 서둘러 줬으면"
    },
    {
      "t": 1386,
      "text": "좋겠습니다."
    },
    {
      "t": 1387,
      "text": ">> 네. 알겠습니다."
    },
    {
      "t": 1387,
      "text": ">> 네."
    },
    {
      "t": 1391,
      "text": "창의인재교육과에서 그 전국 기능",
      "raw": "창애인재 교육과에서 그 전국 기능"
    },
    {
      "t": 1393,
      "text": "경기대 참여하는데"
    },
    {
      "t": 1396,
      "text": ">> 네."
    },
    {
      "t": 1396,
      "text": ">> 어, 몇 명 한 80 몇 명 가나요?"
    },
    {
      "t": 1399,
      "text": ">> 네. 85명이고요. 저희가 4월에"
    },
    {
      "t": 1402,
      "text": "전라북도 기능 경기대를 했습니다."
    },
    {
      "t": 1404,
      "text": "그때 입상한 학생들입니다.이"
    },
    {
      "t": 1407,
      "text": "학생들이."
    },
    {
      "t": 1408,
      "text": ">> 음. 입상한 학생들."
    },
    {
      "t": 1410,
      "text": ">> 네. 네. 입상한 학생들이 전국대에"
    },
    {
      "t": 1412,
      "text": "이렇게 나가는 겁니다."
    },
    {
      "t": 1414,
      "text": ">> 네."
    },
    {
      "t": 1415,
      "text": "음."
    },
    {
      "t": 1417,
      "text": "그다음에 이제 중등교육가 입시가"
    },
    {
      "t": 1419,
      "text": "가까워지면서 해야 되는 일들이 되게"
    },
    {
      "t": 1422,
      "text": "많아지는 걸로 어 보여지는데요. 특히"
    },
    {
      "t": 1426,
      "text": "대입 진학지도 지원단이랄지 이런"
    },
    {
      "t": 1428,
      "text": "분들이 뭔가 그 뭐죠? 어, 자긍심을"
    },
    {
      "t": 1433,
      "text": "가지고 좀 일할 수 있도록 열심히"
    },
    {
      "t": 1435,
      "text": "저도 좋을 생각이니까요. 이쪽"
    },
    {
      "t": 1437,
      "text": "분들에게 힘을 좀 많이 실어 주시고"
    },
    {
      "t": 1440,
      "text": "그다음에 창업 동아리 같은 경우 제가"
    },
    {
      "t": 1443,
      "text": "이제 도전 모험 교육을 얘기하면서"
    },
    {
      "t": 1446,
      "text": "고등학교 같은 경우 창업을 강조를"
    },
    {
      "t": 1449,
      "text": "하겠다고 했으니까 그냥 창업해라 해서"
    },
    {
      "t": 1452,
      "text": "될 일이 아니잖아요. 미리미리 싹을"
    },
    {
      "t": 1454,
      "text": "우리가 잘 키우고 그런 준비를 해야"
    },
    {
      "t": 1457,
      "text": "되니까 각 학교 내에서 창업 동아리라"
    },
    {
      "t": 1460,
      "text": "할지 이런 것들이 활성화될 수 있도록"
    },
    {
      "t": 1463,
      "text": "그렇게 좀 지원해 주는 방안이 좀"
    },
    {
      "t": 1465,
      "text": "필요할 거고요. 교육 협력과에서 그"
    },
    {
      "t": 1468,
      "text": "학부모 아카데미 운영 계획을 잡고"
    },
    {
      "t": 1471,
      "text": "있는데 특히나이 학부모님들이 강제"
    },
    {
      "t": 1474,
      "text": "동원되거나 이런 상황이 아니라 정말"
    },
    {
      "t": 1477,
      "text": "자율적으로 많이 오실 수 있도록 하고"
    },
    {
      "t": 1479,
      "text": "어 평소에 우리 교육에 관심 있는"
    },
    {
      "t": 1482,
      "text": "분들 이런 분들이 많이 오셔서"
    },
    {
      "t": 1485,
      "text": "자신들이 좀 하고 싶은 얘기도 나눌"
    },
    {
      "t": 1487,
      "text": "수 있는 이런 식으로 좀 운영을"
    },
    {
      "t": 1489,
      "text": "특별히 부탁드립니다."
    },
    {
      "t": 1490,
      "text": ">> 네."
    },
    {
      "t": 1491,
      "text": ">> 예."
    },
    {
      "t": 1493,
      "text": "그래요.이 정도에서 보고를"
    },
    {
      "t": 1497,
      "text": "마치고요. 혹시 여기에서 이제 잠시"
    },
    {
      "t": 1500,
      "text": "우리끼리 뭐 지의를 좀 하실 거랄지"
    },
    {
      "t": 1504,
      "text": "서로 나눌 얘기가 좀 있나요?"
    },
    {
      "t": 1509,
      "text": "보안 설명을 해야 되거나."
    },
    {
      "t": 1514,
      "text": "어, 그런게 없으면 우리 국장님들"
    },
    {
      "t": 1517,
      "text": "여기 새 국장님들 특별히 하실"
    },
    {
      "t": 1520,
      "text": "말씀이나 종합적으로"
    },
    {
      "t": 1523,
      "text": "커멘트 할 수 있는 어 정책님 특별히"
    },
    {
      "t": 1526,
      "text": "없습니까? 예. 예. 교육장님"
    },
    {
      "t": 1532,
      "text": "예 특별히요. 행정국장님 예, 혹시"
    },
    {
      "t": 1536,
      "text": "우리 비서실에도 뭐 전달 사항이나 뭐"
    },
    {
      "t": 1538,
      "text": "있어요?"
    },
    {
      "t": 1540,
      "text": "없습니까?"
    },
    {
      "t": 1544,
      "text": "자, 없으면 지금 이제"
    },
    {
      "t": 1547,
      "text": "우리 주관 회의는 내용을이 정도에서"
    },
    {
      "t": 1551,
      "text": "마치고"
    },
    {
      "t": 1552,
      "text": "어 우리에이"
    },
    {
      "t": 1556,
      "text": "정도에서 마치겠습니다."
    }
  ]
}
